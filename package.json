{
  "name": "@moewolf/moe-icons-cli",
  "version": "0.0.12",
  "description": "Moeicons CLI: install React, Vue, Vanilla, or Assets icon targets, manage releases and login, and expose an MCP server.",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moewolf-dev/moe-icons-cli.git"
  },
  "homepage": "https://github.com/moewolf-dev/moe-icons-cli#readme",
  "bugs": {
    "url": "https://github.com/moewolf-dev/moe-icons-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "moeicons": "bin/moeicons.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:prepare": "npm --prefix ../moe-icons-clitest run dev:prepare",
    "generate-banner": "node scripts/generate-banner.mjs",
    "sync:config-package": "node scripts/sync-config-package.mjs",
    "prebuild": "node scripts/verify-small-pack-pin.mjs && rimraf dist",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-catalog.mjs && node scripts/copy-config-package.mjs && node scripts/copy-small-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run && node --test tests/durable-fallback.test.cjs tests/small-pack-release-guard.test.cjs tests/metered-curl.test.cjs tests/reconcile-package-set-publisher.test.mjs",
    "policy:verify-remote": "node scripts/verify-release-policy-remote.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "prepublishOnly": "node scripts/verify-small-pack-pin.mjs && npm run release:preflight",
    "format": "prettier --write src tests"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vue/server-renderer": "3.5.44",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "figlet": "^1.11.4",
    "happy-dom": "^20.11.1",
    "prettier": "^3.2.0",
    "sharp": "0.35.5",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "vue": "3.5.44"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@clack/core": "^0.4.2",
    "@clack/prompts": "^0.10.1",
    "commander": "^12.1.0",
    "fflate": "^0.8.2",
    "jsonc-parser": "^3.3.1"
  },
  "payloadHash": "9f0f6d1ff7670d165c423a88ec833e14f62496dd4378b339f13719885764b5d0"
}

{
  "name": "@moewolf/moe-icons-cli",
  "version": "0.0.1",
  "description": "Moeicons CLI: install React, Vue, Vanilla, or Assets icon targets, manage releases and login, and expose an MCP server.",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moewolf-dev/moe-icons-cli.git"
  },
  "homepage": "https://github.com/moewolf-dev/moe-icons-cli#readme",
  "bugs": {
    "url": "https://github.com/moewolf-dev/moe-icons-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "moeicons": "bin/moeicons.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate-banner": "node scripts/generate-banner.mjs",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "release:preflight": "node scripts/release-preflight.mjs",
    "prepublishOnly": "npm run release:preflight",
    "format": "prettier --write src tests"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vue/server-renderer": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "figlet": "^1.11.4",
    "happy-dom": "^20.11.1",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "vue": "^3.5.41"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "commander": "^12.1.0",
    "fflate": "^0.8.2",
    "jsonc-parser": "^3.3.1"
  }
}

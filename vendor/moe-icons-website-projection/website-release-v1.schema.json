{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://moeicons.com/contracts/website-release-v1.schema.json",
  "title": "website-release-v1",
  "description": "Activation-neutral website projection release manifest at <version>/release.json (DEC-35/48, section 4.1). It never contains an activationId.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resourceVersion", "sourceCommit", "generatorCommit", "privateDescriptorSha256", "publicDescriptorSha256", "objects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "resourceVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-(?:alpha|beta))?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "generatorCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "privateDescriptorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publicDescriptorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/object" }
    }
  },
  "definitions": {
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "tier", "mediaType", "size", "sha256"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^moeicons/website/v1/releases/[^/]+/(?:free|pro)/[^\\s]+$"
        },
        "tier": { "enum": ["free", "pro"] },
        "mediaType": { "enum": ["vector", "bitmap", "catalog", "snippet", "index", "manifest"] },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
